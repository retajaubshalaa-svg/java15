
package javaapplication25;
import java.time.LocalDate; import java.util.*;

public class JavaApplication25 {
interface Taxable { double TAX_RATE = 0.15; double calculateTax(); }
interface BonusCalculable { double calculateBonus(double performanceScore); }
abstract class Employee implements Taxable, BonusCalculable, Comparable<Employee> {
    private String id;
private String name;
protected double baseSalary;
private LocalDate joinDate;

public Employee(String id, String name, double baseSalary, LocalDate joinDate) {
    this.id = id;
    this.name = name;
    this.baseSalary = baseSalary;
    this.joinDate = joinDate;
}

public abstract double calculateNetSalary();

@Override
public double calculateTax() {
    return calculateNetSalary() * TAX_RATE;
}

@Override
public int compareTo(Employee other) {
    return Double.compare(other.calculateNetSalary(), this.calculateNetSalary());
}

public String getId() {
    return id;
}

public String getName() {
    return name;
}

public double getBaseSalary() {
    return baseSalary;
}

public LocalDate getJoinDate() {
    return joinDate;
}

@Override
public String toString() {
    return "ID: " + id +
           ", Name: " + name +
           ", Net Salary: " + calculateNetSalary();
}

}
   class FullTimeEmployee extends Employee {
       private double allowance;

public FullTimeEmployee(String id, String name, double baseSalary, LocalDate joinDate, double allowance) {
    super(id, name, baseSalary, joinDate);
    this.allowance = allowance;
}

@Override
public double calculateNetSalary() {
    return baseSalary + allowance;
}

@Override
public double calculateBonus(double performanceScore) {
    if (performanceScore < 1.0 || performanceScore > 5.0) {
        throw new IllegalArgumentException("Performance score must be between 1 and 5");
    }

    return baseSalary * 0.10 * performanceScore;
}

   }
   class ContractorEmployee extends Employee {
       private int hourlyRate;
private int hoursWorked;

public ContractorEmployee(String id, String name, LocalDate joinDate, int hourlyRate, int hoursWorked) {
    super(id, name, 0, joinDate);
    this.hourlyRate = hourlyRate;
    this.hoursWorked = hoursWorked;
}

@Override
public double calculateNetSalary() {
    return hourlyRate * hoursWorked;
}

@Override
public double calculateBonus(double performanceScore) {
    if (performanceScore < 1.0 || performanceScore > 5.0) {
        throw new IllegalArgumentException("Performance score must be between 1 and 5");
    }

    return performanceScore > 4.0 ? 500.0 : 0.0;
}

   }
   public class PayrollSystem {
       
   }
    public static void main(String[] args) {
     List<Employee> employees = new ArrayList<>();

    employees.add(new FullTimeEmployee(
        "E001", "Ahmed", 5000,
        LocalDate.of(2022, 3, 15), 1000
    ));

    employees.add(new FullTimeEmployee(
        "E002", "Mohamed", 6000,
        LocalDate.of(2021, 5, 10), 1500
    ));

    employees.add(new ContractorEmployee(
        "E003", "Ali",
        LocalDate.of(2023, 1, 20), 50, 120
    ));

    employees.add(new ContractorEmployee(
        "E004", "Omar",
        LocalDate.of(2020, 8, 5), 60, 100
    ));

    Collections.sort(employees);

    System.out.println("=== Employees Sorted By Net Salary ===");

    for (Employee e : employees) {
        System.out.println(e);
    }

    employees.sort(
        Comparator.comparing(Employee::getJoinDate)
    );

    System.out.println("\n=== Employees Sorted By Join Date ===");

    for (Employee e : employees) {
        System.out.println(e.getName() + " - " + e.getJoinDate());
    }

    double totalTax = 0;
    double totalBonus = 0;

    double[] performanceScores = {4.5, 3.5, 4.8, 4.0};

    for (int i = 0; i < employees.size(); i++) {

        Employee e = employees.get(i);

        totalTax += e.calculateTax();

        totalBonus += e.calculateBonus(performanceScores[i]);
    }

    System.out.println("\n=== Payroll Summary ===");

    System.out.println("Total Employees: " + employees.size());

    System.out.printf("Total Taxes: %.2f%n", totalTax);

    System.out.printf("Total Bonuses: %.2f%n", totalBonus);
}
    }
    

